    "budbexley-main": {aadt:[{% js "rangeland.aadt.budbexley.2023" %},{% js "rangeland.aadt.budbexley.2050-nobuild" %},{% js "rangeland.aadt.budbexley.2050-build" %}],   open:[1,1,1]},
    "budbexley-east": {out:1, aadt:[null,null,null],    open:[1,1,1]},
    "budbexley-gap":  {out:1, aadt:[null,null,null],    open:[0,1,1]},
    "tower":          {out:1, aadt:[null,null,null],    open:[1,1,1]},
    "caliente":       {out:1, aadt:[null,null,null],    open:[1,1,1]},
    "sr54":           {aadt:[{% js "rangeland.aadt.sr54.2023", "high" %},{% js "rangeland.aadt.sr54.2050-nobuild", "high" %},{% js "rangeland.aadt.sr54.2050-build", "high" %}], open:[1,1,1],
                       disp:["{% fact "rangeland.aadt.sr54.2023", "plain" %}","{% fact "rangeland.aadt.sr54.2050-nobuild", "plain" %}","{% fact "rangeland.aadt.sr54.2050-build", "plain" %}"],
                       dlt:[null,"+8%","−9 to −11%"]},
    "gunn":           {out:1, aadt:[null,null,null],    open:[1,1,1]},
    "gunn-s":         {aadt:[{% js "rangeland.aadt.gunn.2023" %},{% js "rangeland.aadt.gunn.2050-nobuild" %},{% js "rangeland.aadt.gunn.2050-build" %}], open:[1,1,1]},
    "cattlegap":      {out:1, aadt:[null,1500,null],    open:[1,1,1], disp:[null,"1,200–1,700",null]},
    "sbranch":        {aadt:[null,{% js "rangeland.aadt.sbranch.2050-nobuild" %},{% js "rangeland.aadt.sbranch.2050-build" %}],  open:[1,1,1]},
    "suncoast-n":     {aadt:[{% js "rangeland.aadt.suncoast-north.2025" %},null,null], open:[1,1,1], fdot:1},
    "suncoast-m":     {aadt:[{% js "rangeland.aadt.suncoast-north.2025" %},null,null], open:[1,1,1], fdot:1},
    "suncoast-s":     {aadt:[{% js "rangeland.aadt.suncoast-south.2025" %},null,null], open:[1,1,1], fdot:1},
    "bvd-sr54":       {aadt:[{% js "rangeland.aadt.bvd-sr54.2023" %},{% js "rangeland.aadt.bvd-sr54.2050-nobuild" %},{% js "rangeland.aadt.bvd-sr54.2050-build" %}], open:[1,1,1]},
    "bvd-rndbt":      {aadt:[{% js "rangeland.aadt.bvd-rndbt.2023" %},{% js "rangeland.aadt.bvd-rndbt.2050-nobuild" %},{% js "rangeland.aadt.bvd-rndbt.2050-build" %}],  open:[1,1,1]},
    "bvd-ne-lo":      {aadt:[{% js "rangeland.aadt.bvd-north.2023" %},{% js "rangeland.aadt.bvd-north.2050-nobuild" %},{% js "rangeland.aadt.bvd-north.2050-build" %}],  open:[1,1,1]},
    "bvd-ne-hi":      {aadt:[null,null,null],    open:[0,0,0]},
    "broadporch":     {aadt:[{% js "rangeland.aadt.broadporch.2023" %},{% js "rangeland.aadt.broadporch.2050-nobuild" %},{% js "rangeland.aadt.broadporch.2050-build" %}],    open:[1,1,1]},
    "ballantrae-s":   {aadt:[{% js "rangeland.aadt.ballantrae-s.2023" %},{% js "rangeland.aadt.ballantrae-s.2050-nobuild" %},{% js "rangeland.aadt.ballantrae-s.2050-build" %}], open:[1,1,1]},
    "ballantrae-m":   {aadt:[{% js "rangeland.aadt.ballantrae-n.2023" %},{% js "rangeland.aadt.ballantrae-n.2050-nobuild" %},{% js "rangeland.aadt.ballantrae-n.2050-build" %}],    open:[1,1,1]},
    "ballantrae-n":   {out:1, aadt:[null,null,null],    open:[1,1,1]},
    "sunlake-s":      {out:1, aadt:[null,null,null],    open:[1,1,1]},
    "sunlake-n":      {out:1, aadt:[null,null,null],    open:[0,0,0]},
    "us41":           {aadt:[{% js "rangeland.aadt.us41-fdot.2025", "high" %},null,null], open:[1,1,1], fdot:1}
  };

  var INT = {
    "rg-gunn":    {name:"Rangeland Blvd at Gunn Hwy",       g:[{% js "rangeland.los.rg-gunn.2023" %},{% js "rangeland.los.rg-gunn.2050-nobuild" %},{% js "rangeland.los.rg-gunn.2050-build" %}], on:["rangeland","gunn"]},
    "rg-cattle":  {name:"Rangeland Blvd at Cattle Gap Trl", g:[{% js "rangeland.los.rg-cattle.2023" %},{% js "rangeland.los.rg-cattle.2050-nobuild" %},{% js "rangeland.los.rg-cattle.2050-build" %}], on:["rangeland","cattlegap"]},
    "bvd-rndbt":  {name:"Bexley Village Dr roundabout",     g:[{% js "rangeland.los.bvd-rndbt.2023" %},{% js "rangeland.los.bvd-rndbt.2050-nobuild" %},{% js "rangeland.los.bvd-rndbt.2050-build" %}], on:["rangeland","budbexley","bexleyvillage"]},
    "bb-ballan":  {name:"Bud Bexley Pkwy at Ballantrae",    g:[{% js "rangeland.los.bb-ballan.2023" %},{% js "rangeland.los.bb-ballan.2050-nobuild" %},{% js "rangeland.los.bb-ballan.2050-build" %}], on:["budbexley","ballantrae"]},
    "sr-gunn":    {name:"SR 54 at Gunn Hwy",                g:[{% js "rangeland.los.sr-gunn.2023" %},{% js "rangeland.los.sr-gunn.2050-nobuild" %},{% js "rangeland.los.sr-gunn.2050-build" %}], on:["sr54","gunn"]},
    "sr-sbranch": {name:"SR 54 at S Branch Blvd",           g:[{% js "rangeland.los.sr-sbranch.2023" %},{% js "rangeland.los.sr-sbranch.2050-nobuild" %},{% js "rangeland.los.sr-sbranch.2050-build" %}], on:["sr54","sbranch"]},
    "sr-sunc-w":  {name:"SR 54 at Suncoast ramps, west",    g:[{% js "rangeland.los.sr-sunc-w.2023" %},{% js "rangeland.los.sr-sunc-w.2050-nobuild" %},{% js "rangeland.los.sr-sunc-w.2050-build" %}], on:["sr54","suncoast"]},
    "sr-sunc-e":  {name:"SR 54 at Suncoast ramps, east",    g:[{% js "rangeland.los.sr-sunc-e.2023" %},{% js "rangeland.los.sr-sunc-e.2050-nobuild" %},{% js "rangeland.los.sr-sunc-e.2050-build" %}], on:["sr54","suncoast"]},
    "sr-bvd":     {name:"SR 54 at Bexley Village Dr",       g:[{% js "rangeland.los.sr-bvd.2023" %},{% js "rangeland.los.sr-bvd.2050-nobuild" %},{% js "rangeland.los.sr-bvd.2050-build" %}], on:["sr54","bexleyvillage"]},
    "sr-ballan":  {name:"SR 54 at Ballantrae Blvd",         g:[{% js "rangeland.los.sr-ballan.2023" %},{% js "rangeland.los.sr-ballan.2050-nobuild" %},{% js "rangeland.los.sr-ballan.2050-build" %}], on:["sr54","ballantrae"], flag:1},
    "sr-sunlake": {name:"SR 54 at Sunlake Blvd",            g:[{% js "rangeland.los.sr-sunlake.2023" %},{% js "rangeland.los.sr-sunlake.2050-nobuild" %},{% js "rangeland.los.sr-sunlake.2050-build" %}], on:["sr54","sunlake"]}
  };

  /* The three tabs, in order. Wording lives in index.html: the tab labels are
     in the .nmviews block, the captions under the key are in the figcaption.
     Only the keys are here, and they must match the data-view attributes. */
  var VIEWS = [{k:"today"}, {k:"notbuilt"}, {k:"built"}];

  document.addEventListener("DOMContentLoaded", function(){
    var svg = document.getElementById("nm-map");
    var tabs = document.getElementById("nm-views");
    var cap = document.getElementById("nm-cap");
    if (!svg || !tabs || !cap) return;
    var vi = 0;

    function band(v){
      if (v == null) return 0;
      if (v < 5000) return 1;
      if (v < 15000) return 2;
      if (v < 25000) return 3;
      if (v < 40000) return 4;
      return 5;
    }
    function gc(g){
      return g === "F" ? "g-crit" : g === "E" ? "g-serious" : g === "D" ? "g-warn" : "g-good";
    }
    function setCls(el, v){ el.setAttribute("class", v); }

    /* change against the view immediately to the left; null when there is
       nothing honest to say */
    function delta(d){
      if (vi === 0) return null;
      var a = d.aadt[vi - 1], b = d.aadt[vi];
      if (a == null || b == null || !a || !d.open[vi] || !d.open[vi - 1]) return null;
      var pct = Math.round((b - a) / a * 100), diff = b - a;
      var txt = (d.dlt && d.dlt[vi]) ? d.dlt[vi]
              : (pct === 0 ? "no change" : (pct > 0 ? "+" : "\u2212") + Math.abs(pct) + "%");
      return {txt:txt, dir: pct > 0 ? "up" : pct < 0 ? "dn" : "flat",
              big: Math.abs(pct) >= 10 || Math.abs(diff) >= 2000};
    }

    function paint(){
      var i;
      var segs = svg.querySelectorAll(".nmseg");
      for (i = 0; i < segs.length; i++){
        var g = segs[i], d = SEG[g.getAttribute("data-seg")];
        if (!d) continue;
        var c = "nmseg";
        if (!d.open[vi]) c += " s-absent";
        else if (d.out) c += " s-out";
        else { var b = band(d.aadt[vi]); c += b ? " b" + b : " s-hollow"; }
        setCls(g, c);
      }
      var ds = svg.querySelectorAll("#nm-deltas text");
      for (i = 0; i < ds.length; i++){
        var t = ds[i], sd = SEG[t.getAttribute("data-seg")], x = sd ? delta(sd) : null;
        if (!x || !x.big || sd.out){ t.textContent = ""; setCls(t, "delta lbl"); }
        else { t.textContent = x.txt; setCls(t, "delta lbl " + x.dir); }
      }
      var gl = svg.querySelectorAll("#nm-grades text");
      for (i = 0; i < gl.length; i++){
        var gd = INT[gl[i].getAttribute("data-int")];
        gl[i].textContent = gd ? gd.g[vi] : "";
      }
      var cs = svg.querySelectorAll("#nm-stations circle");
      for (i = 0; i < cs.length; i++){
        var k = cs[i].getAttribute("data-int"), id = k ? INT[k] : null;
        setCls(cs[i], "stn" + (id ? " " + gc(id.g[vi]) : ""));
      }
      var u = document.getElementById("nm-stn-us41ridge");
      if (u) setCls(u, "stn" + (vi === 0 ? " absent" : ""));
      var caps = cap.querySelectorAll("[data-view]");
      for (i = 0; i < caps.length; i++){
        caps[i].classList.toggle("on", caps[i].getAttribute("data-view") === VIEWS[vi].k);
      }
    }

    /* hover isolates one street; there is no detail panel on this page */
    function streetOf(t){
      while (t && t !== svg){
        if (t.getAttribute && t.getAttribute("data-street")) return t.getAttribute("data-street");
        t = t.parentNode;
      }
      return null;
    }
    function highlight(s){
      var all = svg.querySelectorAll(".nmseg,.lbl"), i;
      if (!s){
        svg.classList.remove("dim");
        for (i = 0; i < all.length; i++) all[i].classList.remove("on");
        return;
      }
      svg.classList.add("dim");
      for (i = 0; i < all.length; i++){
        if (all[i].getAttribute("data-street") === s) all[i].classList.add("on");
        else all[i].classList.remove("on");
      }
    }
    svg.addEventListener("mouseover", function(e){ var s = streetOf(e.target); if (s) highlight(s); });
    svg.addEventListener("mouseleave", function(){ highlight(null); });

    tabs.addEventListener("click", function(e){
      var b = e.target;
      while (b && b !== this && b.tagName !== "BUTTON") b = b.parentNode;
      if (!b || b === this) return;
      var want = b.getAttribute("data-view"), idx = -1, i;
      for (i = 0; i < VIEWS.length; i++) if (VIEWS[i].k === want) idx = i;
      if (idx < 0) return;
      vi = idx;
      var bs = this.querySelectorAll("button");
      for (i = 0; i < bs.length; i++) bs[i].setAttribute("aria-pressed", bs[i] === b ? "true" : "false");
      paint();
    });

    paint();
  });
})();

/* ==========================================================================
   FACT DETAILS
   Figures taken from the county's documents are printed as small buttons.
   Tapping one opens a box saying what the figure is, which document it comes
   from, how it has been checked, and the reader-check form (READER CHECKS).
   The details are in the page as JSON (#fact-data).
   ========================================================================== */
(function(){
  document.documentElement.classList.add("has-facts");
  var MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  function when(d){
    var m = /^(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?$/.exec(String(d || ""));
    if (!m) return d || "";
    return (m[3] ? +m[3] + " " : "") + (m[2] ? MONTHS[+m[2] - 1] + " " : "") + m[1];
  }
  function el(tag, cls, text){
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  document.addEventListener("DOMContentLoaded", function(){
    var node = document.getElementById("fact-data"), data;
    if (!node) return;
    try { data = JSON.parse(node.textContent); } catch (e) { return; }

    var box = el("div", "factpop"), opener = null;
    box.setAttribute("role", "dialog");
    box.setAttribute("aria-label", "Where this figure comes from");
    box.tabIndex = -1;
    box.hidden = true;
    document.body.appendChild(box);

    function close(){
      if (box.hidden) return;
      box.hidden = true;
      if (opener) { opener.setAttribute("aria-expanded", "false"); opener.focus(); }
      opener = null;
    }
    function link(text, href, cls){
      var a = el("a", cls, text);
      a.href = href;
      a.rel = "noopener";
      a.target = "_blank";
      return a;
    }
    /* An email address is optional on both forms; if one is given it must look
       complete (something@something.something, no spaces) so a reply can reach
       it. The contact form below has the same check. */
    var EMAIL_MSG = "That email address doesn\u2019t look complete. Please check it, or leave it blank.";
    function badEmail(v){ v = v.trim(); return v !== "" && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); }
    /* READER CHECKS: "I checked this against the document" - Matches / Doesn't
       match - sent straight to Patrick's Google Sheet through his Apps Script
       (data/site.yaml -> reader_checks). A plain POST: no Google code runs on
       this page and nothing is stored in the reader's browser. Hidden until
       that address is set. Design and rules: docs/reader-checks.md. */
    function checkForm(id, f){
      var wrap = el("div", "rck"), verdict = "";
      wrap.appendChild(el("p", "rck-q", "I checked this against the document:"));
      var row = el("div", "rck-row");
      var yes = el("button", "rck-v", "Matches"), no = el("button", "rck-v", "Doesn\u2019t match");
      yes.type = no.type = "button";
      row.appendChild(yes); row.appendChild(no); wrap.appendChild(row);
      var more = el("form", "rck-more"); more.hidden = true; more.noValidate = true;
      function field(label, name, type, rows){
        var l = el("label", "rck-f"); l.appendChild(el("span", null, label));
        var i = el(rows ? "textarea" : "input"); i.name = name; if (!rows) i.type = type || "text"; else i.rows = rows;
        i.maxLength = rows ? 1000 : 200; l.appendChild(i); more.appendChild(l); return i;
      }
      var says = field("What does the document say?", "says", "text", 3);
      var page = field("Which page or board?", "page");
      var name = field("Your name (optional)", "name");
      var email = field("Email, if you\u2019d like a reply (optional)", "email", "email");
      email.addEventListener("input", function(){ email.removeAttribute("aria-invalid"); });
      var cl = el("label", "rck-c"), credit = el("input"); credit.type = "checkbox";
      cl.appendChild(credit); cl.appendChild(document.createTextNode(" You may credit me by name")); more.appendChild(cl);
      var trap = el("input"); trap.type = "text"; trap.name = "xq_extra"; trap.tabIndex = -1; trap.autocomplete = "off";
      trap.className = "rck-trap"; trap.setAttribute("aria-hidden", "true"); more.appendChild(trap);
      var send = el("button", "rck-send", "Send"); send.type = "submit"; more.appendChild(send);
      more.appendChild(el("p", "rck-note", "Goes to a private Google Sheet that only Patrick can see. Name and email are optional and never published unless you tick the box."));
      var status = el("p", "rck-status"); status.setAttribute("role", "status");
      wrap.appendChild(more); wrap.appendChild(status);
      function pick(v){
        verdict = v;
        yes.setAttribute("aria-pressed", v === "matches" ? "true" : "false");
        no.setAttribute("aria-pressed", v === "differs" ? "true" : "false");
        says.parentNode.hidden = page.parentNode.hidden = (v === "matches");
        more.hidden = false;
        (v === "differs" ? says : send).focus();
      }
      yes.addEventListener("click", function(){ pick("matches"); });
      no.addEventListener("click", function(){ pick("differs"); });
      more.addEventListener("submit", function(e){
        e.preventDefault();
        if (verdict === "differs" && !says.value.trim()) { status.textContent = "Please say what the document says."; says.focus(); return; }
        if (badEmail(email.value)) { status.textContent = EMAIL_MSG; email.setAttribute("aria-invalid", "true"); email.focus(); return; }
        send.disabled = true; status.textContent = "Sending\u2026";
        var body = JSON.stringify({fact: id, statement: f.s, value: f.v, verdict: verdict,
          says: says.value, page: page.value, name: name.value, email: email.value.trim(),
          credit: credit.checked, trap: trap.value, pageUrl: location.href.split("#")[0]});
        /* The script answers {"ok": true} once the row is in Patrick's Sheet, so
           "received" is only said when it really was. (A plain-text POST needs
           no extra permission from Google, and its reply can be read.) */
        function failed(msg){ send.disabled = false; status.textContent = msg; }
        fetch(data.rc, {method: "POST", headers: {"Content-Type": "text/plain;charset=utf-8"}, body: body})
          .then(function(r){ return r.json(); })
          .then(function(res){
            if (!res || res.ok !== true) { failed("It didn\u2019t go through \u2014 please try again in a minute."); return; }
            wrap.textContent = "";
            wrap.appendChild(el("p", "rck-done", "\u2713 Received \u2014 thank you. " + (verdict === "matches" ? "It helps to know a figure has been checked." : "Patrick will check it against the document.")));
          })
          .catch(function(){
            failed("Couldn\u2019t confirm it arrived. Please check your connection and try again in a few minutes.");
          });
      });
      return wrap;
    }

    /* CONNECTED: the figure's place, other figures there (from any project or
       document), and linked statements - from data/places.yaml and links.yaml. Tapping one of the other
       figures opens it in this same box. */
    function connected(cx){
      var wrap = el("div", "fcx"), root = data.root || "", MAX = 6;
      wrap.appendChild(el("p", "fcx-h", "Connected"));
      function go(text, href){ var a = el("a", null, text); a.href = root + href; return a; }
      if (cx.pl){
        var pl = el("p", "fcx-pl"); pl.appendChild(document.createTextNode("Place: "));
        pl.appendChild(go(cx.pl.n, cx.pl.h)); wrap.appendChild(pl);
      }
      if (cx.here && cx.here.length){
        wrap.appendChild(el("p", "fcx-sub", "Also here"));
        var ul = el("ul", "fcx-list");
        cx.here.slice(0, MAX).forEach(function(id){
          var g = data.facts[id]; if (!g) return;
          var li = el("li"), b = el("button", "fact fcx-fact"); b.type = "button";
          b.setAttribute("data-fact", id);
          b.appendChild(el("span", "fcx-v", g.v)); b.appendChild(el("span", "fcx-s", g.s));
          li.appendChild(b); ul.appendChild(li);
        });
        wrap.appendChild(ul);
        if (cx.here.length > MAX && cx.pl) {
          var more = el("p", "fcx-more"); more.appendChild(go("and " + (cx.here.length - MAX) + " more at this place \u2192", cx.pl.h)); wrap.appendChild(more);
        }
      }
      (cx.lk || []).forEach(function(l){
        var p = el("p", "fcx-pl"); p.appendChild(document.createTextNode(l.t + ": ")); p.appendChild(go(l.n, l.h)); wrap.appendChild(p);
      });
      return wrap;
    }

    function open(btn){
      var id = btn.getAttribute("data-fact"), f = data.facts[id];
      if (!f) return;
      var inside = box.contains(btn);           /* a connected figure tapped inside the box */
      if (!inside) {
        if (opener) opener.setAttribute("aria-expanded", "false");
        opener = btn;
        btn.setAttribute("aria-expanded", "true");
      }
      box.textContent = "";

      var x = el("button", "x", "×");
      x.type = "button";
      x.setAttribute("aria-label", "Close");
      x.addEventListener("click", close);
      box.appendChild(x);

      if (f.st === "disputed") box.appendChild(el("p", "fst", "This figure is under dispute."));
      if (f.st === "superseded") box.appendChild(el("p", "fst", f.now ? "A newer document has replaced this figure: now " + f.now + "." : "A newer document has replaced this figure."));
      box.appendChild(el("p", "fv", f.v));
      box.appendChild(el("p", "fs", f.s));
      if (f.was) box.appendChild(el("p", "fwas", "Earlier figure: " + f.was + ". See the history on All figures and sources."));

      var src = el("p", "fm");
      src.appendChild(document.createTextNode("Source: "));
      src.appendChild(f.src.url ? link(f.src.t, f.src.url) : document.createTextNode(f.src.t));
      var bits = [f.src.p, when(f.src.d || f.asof), f.loc].filter(Boolean);
      if (bits.length) src.appendChild(document.createTextNode(" · " + bits.join(" · ")));
      box.appendChild(src);
      // who has checked it against the document: Patrick ("verified") and/or Claude ("ai_checked")
      var ck = el("p", "fck");
      if (f.vf) ck.appendChild(el("span", "vtag human", "Verified by a human " + when(f.vf)));
      if (f.ai) ck.appendChild(el("span", "vtag ai", "Checked by AI " + when(f.ai)));
      if (!f.vf && !f.ai) ck.appendChild(el("span", "vtag none", "Not yet checked against the source"));
      box.appendChild(ck);
      if (f.note) box.appendChild(el("p", "fn", f.note));
      if (f.cx) box.appendChild(connected(f.cx));

      if (data.rc) box.appendChild(checkForm(id, f));
      var p = el("p", "fa");
      var all = el("a", "fall", "All figures and sources");
      all.href = (data.root || "") + "facts/#" + encodeURIComponent(id);
      p.appendChild(all);
      box.appendChild(p);
      box.hidden = false;
      box.focus();
    }

    document.addEventListener("click", function(e){
      var t = e.target;
      while (t && t !== document && !(t.classList && t.classList.contains("fact"))) t = t.parentNode;
      if (t && t !== document) {
        if (t === opener && !box.hidden) close(); else { open(t); box.scrollTop = 0; }
        return;
      }
      if (!box.hidden && !box.contains(e.target)) close();
    });
    document.addEventListener("keydown", function(e){
      if (e.key === "Escape") close();
    });
  });
})();

/* ==========================================================================
   FULL-SCREEN MAP (phones)
   On a narrow or short screen the map shows small, fitted to the width, with
   an "Open the map full screen" button (tapping the map does the same). Full
   screen, the three views sit along the bottom; Close, the Escape key or the
   phone's Back button return to the page. Without JavaScript the map simply
   shows fitted to the width.
   ========================================================================== */
(function(){
  document.addEventListener("DOMContentLoaded", function(){
    var sec = document.getElementById("netmap"), fig = document.getElementById("nm-fig");
    var openBtn = document.getElementById("nm-open"), closeBtn = document.getElementById("nm-close");
    if (!sec || !fig || !openBtn || !closeBtn) return;
    var root = document.documentElement, small = window.matchMedia ? matchMedia("(max-width:700px), (max-height:500px)") : null;
    var isOpen = false, pushed = false;
    openBtn.hidden = false;
    root.classList.add("js-map");

    function open(){
      if (isOpen) return;
      isOpen = true;
      sec.classList.add("nm-full");
      root.classList.add("nm-lock");
      fig.setAttribute("role", "dialog");
      fig.setAttribute("aria-modal", "true");
      fig.setAttribute("aria-label", "Traffic map, full screen");
      try { history.pushState({nmfull: 1}, ""); pushed = true; } catch (e) {}
      unhighlight();
      closeBtn.focus();
    }
    function close(fromHistory){
      if (!isOpen) return;
      isOpen = false;
      sec.classList.remove("nm-full");
      root.classList.remove("nm-lock");
      fig.removeAttribute("role"); fig.removeAttribute("aria-modal"); fig.removeAttribute("aria-label");
      if (pushed && !fromHistory) { pushed = false; try { history.back(); } catch (e) {} }
      pushed = false;
      openBtn.focus();
    }
    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", function(){ close(false); });
    /* On a touch screen a tap counts as hovering, which fades every other
       street; the map would stay faded. Clear that when the map opens, and
       when someone taps an empty part of it. */
    var svg = fig.querySelector("svg");
    function unhighlight(){ if (svg) svg.dispatchEvent(new Event("mouseleave")); }
    fig.addEventListener("click", function(e){
      if (!isOpen && small && small.matches && e.target.closest("svg")) { open(); return; }
      if (!e.target.closest("[data-street]")) unhighlight();
    });
    document.addEventListener("keydown", function(e){ if (e.key === "Escape") close(false); });
    window.addEventListener("popstate", function(){ close(true); });
  });
})();

/* ==========================================================================
   SHARE (footer of every page)
   Uses the phone's own share menu where there is one; otherwise copies the
   page's address. No third-party code. The button stays hidden if neither
   is available.
   ========================================================================== */
(function(){
  document.addEventListener("DOMContentLoaded", function(){
    var btns = document.querySelectorAll(".share"), i;
    var canShare = !!navigator.share, canCopy = !!(navigator.clipboard && navigator.clipboard.writeText);
    if (!canShare && !canCopy) return;
    for (i = 0; i < btns.length; i++){
      btns[i].hidden = false;
      if (!canShare) btns[i].textContent = "Copy link to this page";
      btns[i].addEventListener("click", function(){
        var msg = this.parentNode.querySelector(".sharemsg"), url = location.href.split("#")[0];
        function say(t){ if (msg) { msg.textContent = t; setTimeout(function(){ msg.textContent = ""; }, 4000); } }
        if (canShare) {
          navigator.share({title: document.title, url: url}).catch(function(){});
        } else {
          navigator.clipboard.writeText(url).then(function(){ say("Link copied"); }, function(){ say(url); });
        }
      });
    }
  });
})();

/* ==========================================================================
   SOURCES ON THIS SLIDE
   Each Highlights slide gets a fold-out list of every figure and statement on
   it that links to a document, with how it has been checked. Built from what
   is tappable on the slide, so it can never go out of date. Tapping an entry
   opens the same details box as tapping the figure itself.
   ========================================================================== */
(function(){
  document.addEventListener("DOMContentLoaded", function(){
    var node = document.getElementById("fact-data"), data;
    if (!node) return;
    try { data = JSON.parse(node.textContent); } catch (e) { return; }
    var slides = document.querySelectorAll(".slide"), i;
    for (i = 0; i < slides.length; i++){
      var btns = slides[i].querySelectorAll("[data-fact],[data-calc]"), seen = {}, ids = [], j;
      for (j = 0; j < btns.length; j++){
        var list = (btns[j].getAttribute("data-fact") || btns[j].getAttribute("data-calc")).split(" ");
        for (var k = 0; k < list.length; k++){
          var id = list[k];
          if (!seen[id] && data.facts[id]) { seen[id] = 1; ids.push(id); }
        }
      }
      if (!ids.length) continue;
      var human = 0, ai = 0;
      for (j = 0; j < ids.length; j++){ if (data.facts[ids[j]].vf) human++; else if (data.facts[ids[j]].ai) ai++; }
      var box = document.createElement("details");
      box.className = "slsrc";
      var sum = document.createElement("summary");
      sum.textContent = "Sources on this slide \u00b7 " + ids.length + (ids.length === 1 ? " item" : " items") +
        " \u00b7 " + human + " verified by a human" + (ai ? ", " + ai + " checked by AI" : "") +
        (ids.length - human - ai ? ", " + (ids.length - human - ai) + " not yet checked" : "");
      box.appendChild(sum);
      var ul = document.createElement("ul");
      for (j = 0; j < ids.length; j++){
        var f = data.facts[ids[j]], li = document.createElement("li"), b = document.createElement("button");
        b.type = "button"; b.className = "fact slsrc-item"; b.setAttribute("data-fact", ids[j]);
        b.textContent = f.v + " \u2014 " + f.s;
        var tag = document.createElement("span");
        tag.className = "vtag " + (f.vf ? "human" : f.ai ? "ai" : "none");
        tag.textContent = f.vf ? "Verified by a human" : f.ai ? "Checked by AI" : "Not yet checked";
        var src = document.createElement("span");
        src.className = "slsrc-doc"; src.textContent = f.src.t;
        li.appendChild(b); li.appendChild(document.createTextNode(" ")); li.appendChild(tag);
        li.appendChild(src); ul.appendChild(li);
      }
      box.appendChild(ul);
      var foot = slides[i].querySelector(".foot");
      if (foot) foot.parentNode.insertBefore(box, foot.nextSibling); else slides[i].appendChild(box);
    }
    /* a worked-out figure opens its slide's source list */
    document.addEventListener("click", function(e){
      var c = e.target.closest && e.target.closest(".calc");
      if (!c) return;
      var s = c.closest(".slide"), box = s && s.querySelector(".slsrc");
      if (box) { box.open = true; box.scrollIntoView({block: "nearest", behavior: "smooth"}); }
    });
  });
})();
/* CONTACT FORM (How this site is built, about/#contact): a message to Patrick,
   sent to the same Apps Script as reader checks with kind "message", which
   puts it in the "Messages" tab of his Sheet. A plain POST, as for reader
   checks: no Google code runs on the page and nothing is stored in the
   browser. "Received" is said only when the script answers {"ok": true}.
   Script and set-up: docs/reader-checks.md. */
(function(){
  document.addEventListener("DOMContentLoaded", function(){
    var form = document.querySelector("form.contactform");
    if (!form || !window.fetch) return;
    var url = form.getAttribute("data-url"), status = form.querySelector(".rck-status"), send = form.querySelector(".rck-send");
    form.hidden = false;
    function val(n){ return form.elements[n].value; }
    var emailBox = form.elements.email;
    /* the same check as the reader-check form's: blank, or a complete address */
    function badEmail(v){ v = v.trim(); return v !== "" && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); }
    emailBox.addEventListener("input", function(){ emailBox.removeAttribute("aria-invalid"); });
    function failed(msg){ send.disabled = false; status.textContent = msg; }
    form.addEventListener("submit", function(e){
      e.preventDefault();
      if (!val("message").trim()) { status.textContent = "Please write a message."; form.elements.message.focus(); return; }
      if (badEmail(val("email"))) { status.textContent = "That email address doesn\u2019t look complete. Please check it, or leave it blank."; emailBox.setAttribute("aria-invalid", "true"); emailBox.focus(); return; }
      send.disabled = true; status.textContent = "Sending\u2026";
      var body = JSON.stringify({kind: "message", message: val("message"), name: val("name"), email: val("email").trim(),
        trap: val("xq_extra"), pageUrl: location.href.split("#")[0]});
      fetch(url, {method: "POST", headers: {"Content-Type": "text/plain;charset=utf-8"}, body: body})
        .then(function(r){ return r.json(); })
        .then(function(res){
          if (!res || res.ok !== true) { failed("It didn\u2019t go through \u2014 please try again in a minute."); return; }
          var done = document.createElement("p");
          done.className = "rck-done"; done.setAttribute("role", "status");
          done.textContent = "\u2713 Received \u2014 thank you." + (val("email").trim() ? " Patrick will reply to the email you gave." : "");
          form.parentNode.replaceChild(done, form);
        })
        .catch(function(){ failed("Couldn\u2019t confirm it arrived. Please check your connection and try again in a few minutes."); });
    });
  });
})();
