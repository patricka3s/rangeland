{#- TEMPLATE NOTE (not copied into the built app.js)
    The traffic figures and grades in the NETWORK MAP block come from
    data/facts/rangeland.yaml. Edit them there, not here: each js tag below is
    replaced by the fact's value when the site is built.
    Rows marked out:1 are drawn grey and their figures are never shown, so
    those few are still written in directly. -#}
/* LIGHT/DARK: pages follow the phone or computer's own setting unless the
   reader picks the other with the switch in the project bar. The choice is
   kept on this device only (nothing is sent anywhere), and picking the same
   as the device's setting goes back to following it. Runs before the page
   is drawn, so there's no flash of the wrong colours. */
(function(){
  var KEY = "pasco-roadmap-theme", root = document.documentElement, saved = null;
  var mq = window.matchMedia ? matchMedia("(prefers-color-scheme: dark)") : null;
  var BG = { light: "#F4F5F7", dark: "#0F1218" };
  try { saved = localStorage.getItem(KEY); } catch (e) {}
  if (saved === "light" || saved === "dark") root.setAttribute("data-theme", saved);
  function device(){ return mq && mq.matches ? "dark" : "light"; }
  function now(){ return root.getAttribute("data-theme") || device(); }
  function paint(){
    var t = now(), other = t === "dark" ? "light" : "dark", i;
    var b = document.querySelectorAll(".pb-theme");
    for (i = 0; i < b.length; i++){
      b[i].hidden = false;
      b[i].setAttribute("data-now", t);
      b[i].setAttribute("aria-label", "Switch to " + other + " mode");
      b[i].title = "Switch to " + other + " mode";
    }
    /* the phone's own bar above the page */
    var m = document.querySelectorAll('meta[name="theme-color"]');
    for (i = 0; i < m.length; i++){
      var own = /dark/.test(m[i].getAttribute("media") || "") ? BG.dark : BG.light;
      m[i].setAttribute("content", root.hasAttribute("data-theme") ? BG[t] : own);
    }
  }
  function choose(t){
    if (t === device()){
      root.removeAttribute("data-theme");
      try { localStorage.removeItem(KEY); } catch (e) {}
    } else {
      root.setAttribute("data-theme", t);
      try { localStorage.setItem(KEY, t); } catch (e) {}
    }
    paint();
  }
  document.addEventListener("DOMContentLoaded", function(){
    paint();
    document.addEventListener("click", function(e){
      if (e.target.closest && e.target.closest(".pb-theme")) choose(now() === "dark" ? "light" : "dark");
    });
  });
  if (mq && mq.addEventListener) mq.addEventListener("change", paint);
})();

/* Rangeland guide - behaviour only. Three blocks:
   - reading mode: the Highlights/Full detail toggle, and opening the
     corrections from #notes links;
   - NETWORK MAP: the interactive map's tabs and colours;
   - FACT DETAILS: the box that opens when a figure is tapped.
   No page wording lives here except the two mode descriptions and the
   details box's labels. */

(function(){
  var KEY = "rangeland-reading-mode", root = document.documentElement, saved = null;
  try { saved = localStorage.getItem(KEY); } catch (e) {}
  var mode = (saved === "full") ? "full" : "brief";
  if (mode === "brief") root.classList.add("brief");

  function apply(m){
    root.classList.toggle("brief", m === "brief");
    var b = document.querySelectorAll(".seg button[data-mode]"), i;
    for (i = 0; i < b.length; i++){
      b[i].setAttribute("aria-pressed", b[i].getAttribute("data-mode") === m ? "true" : "false");
    }
    var n = document.getElementById("modenote");
    if (n) n.textContent = (m === "brief")
      ? "The corridor, the numbers, and the questions to ask."
      : "The whole guide \u2014 workings, definitions, caveats and sources.";
    try { localStorage.setItem(KEY, m); } catch (e) {}
    if (m === "brief" && window.scrollY > 400) window.scrollTo(0, 0);
  }

  document.addEventListener("DOMContentLoaded", function(){
    apply(mode);

    // The corrections list is collapsed by default. Anything that links to
    // #notes should open it, or the reader lands on a closed box.
    function openNotes(){
      if (location.hash !== "#notes") return;
      try {
        var d = document.querySelector("#notes details");
        if (d) d.open = true;
      } catch (e) {}
    }
    openNotes();
    window.addEventListener("hashchange", openNotes);

    var seg = document.querySelector(".seg");
    if (!seg) return;
    seg.addEventListener("click", function(e){
      var t = e.target;
      while (t && t !== seg && t.tagName !== "BUTTON") t = t.parentNode;
      if (t && t.tagName === "BUTTON" && t.hasAttribute("data-mode")) apply(t.getAttribute("data-mode"));
    });
  });
})();

/* ==========================================================================
   NETWORK MAP
   The figures below are read from the county's three traffic boards shown at
   Public Workshop #3 on 24 September 2026. aadt and open are [2023, 2050 not
   built, 2050 built]; aadt null means no figure for that year; open 0 means the
   road is not open to traffic then; out:1 means this study never numbers the
   street at all, so it is drawn grey in every view. fdot:1 marks a road the
   boards don't number, whose "today" figure is FDOT's 2025 count instead (the
   map's caption says so); a range uses its high end for the colour, like SR 54.
   No wording lives in this file - tab labels and captions are in index.html.
   ========================================================================== */
(function(){
  var SEG = {
    "ridge-w":        {out:1, aadt:[null,null,null],    open:[1,1,1]},
    "ridge-p2":       {out:1, aadt:[null,null,null],    open:[0,1,1]},
