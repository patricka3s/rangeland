---
permalink: explore/index.html
eleventyExcludeFromCollections: true
---
{#- EXPLORE PAGE (not copied into the built page)
    Built entirely from data/places.yaml and links.yaml plus the facts: every
    stretch and intersection with every figure about it, from any project or document.
    A link to explore/#road-sr54 opens with that road chosen; explore/#<place id>
    scrolls to that card. Nothing here needs editing. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Explore by Road · Pasco Roadmap</title>
<meta name="description" content="Every figure on Pasco Roadmap arranged by the road or intersection it is about, from every project and every document.">
<meta name="author" content="Patrick">
<link rel="canonical" href="https://pascoroadmap.info/explore/">
{% set ogTitle = "Explore by Road · Pasco Roadmap" %}{% set ogDesc = "Every figure arranged by the road or intersection it is about, from every project and every document." %}{% set ogPath = "explore/" %}{% include "social.njk" %}
{% set root = "../" %}{% include "shared-head.njk" %}
<script src="../app.js"></script>
</head>
<body class="xppage">
<div class="wrap">
{% set current = "explore" %}{% include "project-bar.njk" %}

<header>
  <h1>Explore by Road</h1>
  <p class="standfirst">Pick a road to see the projects on it and every figure published about it, from every project and every document: the county&#8217;s traffic boards, FDOT&#8217;s counts, the Turnpike&#8217;s study and the county budget, side by side. Pick a second road to go straight to where the two meet. Tap any figure to see its source.</p>
  {%- set withFigures = explore.roads | selectattr("hasFigures") | list %}
  <p class="xp-count">{{ explore.counts.placed }} figures &#183; {{ withFigures.length }} roads with figures &#183; {{ explore.counts.places }} stretches and intersections &#183; {{ projectList.rows.length }} listed projects</p>
</header>

<section aria-labelledby="h-places">
  <h2 id="h-places" class="visually-hidden">Roads</h2>
  <div class="xp-pick" id="xppick">
    <label class="xp-sel"><span>Road</span>
      <select id="xp-road1">
        <option value="all">All roads</option>
        <optgroup label="Roads with figures">{% for r in explore.roads %}{% if r.hasFigures %}<option value="{{ r.id }}">{{ r.name }}</option>{% endif %}{% endfor %}</optgroup>
        <optgroup label="Roads with listed projects only">{% for r in explore.roads | sort(false, false, "name") %}{% if not r.hasFigures %}<option value="{{ r.id }}">{{ r.name }}</option>{% endif %}{% endfor %}</optgroup>
      </select>
    </label>
    <label class="xp-sel"><span>Where it meets</span>
      <select id="xp-road2" disabled>
        <option value="">Pick a road</option>
      </select>
    </label>
  </div>
  <p class="xp-showing" id="xp-showing" role="status" aria-live="polite"></p>
  <script type="application/json" id="xp-roads">{{ explore.roads | dump | safe }}</script>
  {% for r in explore.roads %}{% if r.links.length %}
  <div class="xp-roadnote" data-road-note="{{ r.id }}" hidden>
    {% for l in r.links %}<p><b>{{ l.label }} {{ r.name }}:</b> &#8220;{{ l.from.value }}&#8221;{% src l.from.id %} <span class="xp-src">&#8212; {{ l.src.title }}</span></p>{% endfor %}
  </div>
  {% endif %}{% endfor %}

  {% for r in explore.roads %}{% if r.listed.length %}
  <div class="xp-listed" data-road-listed="{{ r.id }}" hidden>
    <h3>Projects on {{ r.name }}</h3>
    <ul class="plist">{% for row in r.listed %}{% set r = row %}{% include "listed-row.njk" %}{% endfor %}</ul>
    <p class="pl-note"><b>Covered</b> projects have their own guide, with every figure sourced and checked. <b>Listed only</b> projects are copied as written from an official list and linked to it; they aren&#8217;t checked or kept up to date here.</p>
  </div>
  {% endif %}{% endfor %}

  <div class="xp-places">
  {% for p in explore.places %}
    <article class="xplace" id="{{ p.id }}" data-roads="{{ p.roads | join(' ') }}" data-kind="{{ p.kind }}">
      <p class="xp-kind">{% if p.kind == "intersection" %}Intersection{% else %}Stretch of road{% endif %}{% for pj in p.projects %} <span class="pjtag pj-{{ pj.id }}">{{ pj.short }}</span>{% endfor %}</p>
      <h3>{{ p.name }}</h3>
      <p class="xp-meta">{{ p.facts.length }} figure{% if p.facts.length != 1 %}s{% endif %} from {{ p.sources }} document{% if p.sources != 1 %}s{% endif %}</p>
      <ul class="xp-facts">
        {% for f in p.facts %}
        <li{% if f.status == "superseded" %} class="is-superseded"{% endif %}>
          <span class="xpf-v">{% fact f.id, "unit" %}</span>
          <span class="xpf-s">{{ f.statement }}{% if f.status == "superseded" %} <em>(replaced by a newer document)</em>{% endif %}</span>
          <span class="xpf-src">{{ f.src.title }}{% if f.verified %} &#183; <span class="vtag human">Verified by a human</span>{% elif f.ai_checked %} &#183; <span class="vtag ai">Checked by AI</span>{% else %} &#183; <span class="vtag none">Not yet checked</span>{% endif %}</span>
        </li>
        {% endfor %}
      </ul>
      {% for l in p.links %}
      <p class="xp-link"><b>A statement about this place:</b> &#8220;{{ l.from.value }}&#8221;{% src l.from.id %} <span class="xp-src">&#8212; {{ l.src.title }}</span></p>
      {% endfor %}
    </article>
  {% endfor %}
  </div>
  <p id="xp-none" class="fnone" hidden>Nothing here yet.</p>
</section>

<footer>
  <p style="margin:0 0 10px">Built from the same sourced data as the rest of the site. Which road or intersection a figure is about comes from the figure&#8217;s own document; a statement linked to a road names the document that makes the connection. Something missing or wrong? <a href="../about/#contact">Send me a message</a>.</p>
  {% include "share.njk" %}
  <p class="buildstamp">Version {% if build.url %}<a href="{{ build.url }}">{{ build.version }}</a>{% else %}{{ build.version }}{% endif %}{% if build.pr %} &#183; <a href="{{ build.prUrl }}">pull request #{{ build.pr }}</a>{% endif %} &#183; published {{ build.when }} &#183; <a href="{{ root }}about/">How this site is built</a></p>
</footer>
</div>

{% factData %}
<script>
/* Two menus: a road, then (optionally) a road it meets. The second menu lists
   only the roads the first crosses at an intersection that has figures.
   explore/#road-sr54 opens with SR 54 chosen; #road-sr54~gunn with SR 54 at
   Gunn Hwy; #<place id> shows everything and scrolls there.
   Without JavaScript every place shows. */
(function(){
  var roads = JSON.parse(document.getElementById("xp-roads").textContent), byId = {};
  roads.forEach(function(r){ byId[r.id] = r; });
  var r1 = document.getElementById("xp-road1"), r2 = document.getElementById("xp-road2");
  var showing = document.getElementById("xp-showing"), none = document.getElementById("xp-none");
  var cards = document.querySelectorAll(".xplace"), notes = document.querySelectorAll("[data-road-note]"), listed = document.querySelectorAll("[data-road-listed]");
  function fill2(a){
    r2.textContent = "";
    function opt(v, t){ var o = document.createElement("option"); o.value = v; o.textContent = t; r2.appendChild(o); }
    if (a === "all") { opt("", "Pick a road"); r2.disabled = true; return; }
    var x = byId[a].crosses;
    if (!x.length) { opt("", "None yet"); r2.disabled = true; return; }
    opt("", "Anywhere");
    x.forEach(function(o){ opt(o.id, o.name); });
    r2.disabled = false;
  }
  function apply(keepUrl){
    var a = r1.value, b = r2.value, shown = 0, st = 0, xs = 0, i;
    for (i = 0; i < cards.length; i++){
      var rs = " " + cards[i].getAttribute("data-roads") + " ", isX = cards[i].getAttribute("data-kind") === "intersection";
      var ok = a === "all" || (rs.indexOf(" " + a + " ") >= 0 && (!b || (isX && rs.indexOf(" " + b + " ") >= 0)));
      cards[i].hidden = !ok;
      if (ok) { shown++; if (isX) xs++; else st++; }
    }
    for (i = 0; i < notes.length; i++) notes[i].hidden = !(a !== "all" && !b && notes[i].getAttribute("data-road-note") === a);
    for (i = 0; i < listed.length; i++) listed[i].hidden = !(a !== "all" && !b && listed[i].getAttribute("data-road-listed") === a);
    var what = [];
    if (st) what.push(st + (st === 1 ? " stretch" : " stretches"));
    if (xs) what.push(xs + (xs === 1 ? " intersection" : " intersections"));
    showing.textContent = a === "all" ? "Showing every road: " + what.join(" and ") + "."
      : b ? "Showing " + byId[a].name + " at " + byId[b].name + "."
      : "Showing " + byId[a].name + ": " + (what.length ? what.join(" and ") : "no stretches or intersections with figures yet") + ".";
    none.hidden = shown > 0;
    none.textContent = a === "all" ? "Nothing here yet." : "No figures have been published about " + byId[a].name + " on this site yet.";
    if (!keepUrl) try { history.replaceState(null, "", a === "all" ? location.pathname : "#road-" + a + (b ? "~" + b : "")); } catch (e) {}
  }
  r1.addEventListener("change", function(){ fill2(r1.value); apply(); });
  r2.addEventListener("change", function(){ apply(); });
  /* scroll once the page has finished loading, or the browser's own jump to the link wins */
  function goTo(el){ var f = function(){ el.scrollIntoView(); }; if (document.readyState === "complete") f(); else window.addEventListener("load", f, {once: true}); }
  function fromHash(){
    var h = decodeURIComponent(location.hash.slice(1)), m = /^road-([\w-]+)(?:~([\w-]+))?$/.exec(h);
    if (m && byId[m[1]]) {
      r1.value = m[1]; fill2(m[1]);
      if (m[2] && byId[m[1]].crosses.some(function(o){ return o.id === m[2]; })) r2.value = m[2];
      apply(true); goTo(document.getElementById("h-places")); return;
    }
    var el = h && document.getElementById(h);
    if (el) { r1.value = "all"; fill2("all"); apply(true); goTo(el); el.classList.add("xp-hit"); setTimeout(function(){ el.classList.remove("xp-hit"); }, 1600); return; }
    fill2(r1.value); apply(true);
  }
  fromHash();
  window.addEventListener("hashchange", fromHash);
})();
</script>
<script data-goatcounter="https://patricka3s.goatcounter.com/count"
        async src="https://gc.zgo.at/count.js"></script>
</body>
</html>
