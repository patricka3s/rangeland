{#- HOME PAGE (not copied into the built page)
    The landing page: Patrick's introduction, what the site is, what's coming up
    across all projects, a card per project, how the figures are checked, and how
    to get involved. The cards, dates and counts are all built from data/ -
    nothing here needs editing when a project, event or fact is added.
    The introduction is Patrick's voice: ask before rewording it. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
/* Links shared before 29 Sep 2026 pointed at the Rangeland guide, which lived
   here: send a link to one of its sections (e.g. #s5, #notes) on to
   rangeland/, where the guide is now. Runs before anything paints. */
(function(){
  var h = location.hash.slice(1), home = ["top", "projects", "coming-up", "checks", "involved"];
  if (h && home.indexOf(h) < 0) location.replace("rangeland/" + location.hash);
})();
</script>
<title>Pasco Roadmap · A Plain-Language Guide</title>
<meta name="description" content="Plain-language guides to road projects in central Pasco County, Florida: what is proposed, where each project is in the process, what the published figures say, and every figure linked to the public document it comes from.">
<meta name="author" content="Patrick">
<link rel="canonical" href="https://pascoroadmap.info/">
{% set ogTitle = "Pasco Roadmap · A Plain-Language Guide" %}{% set ogDesc = "Plain-language guides to road projects in central Pasco County, Florida, with every figure linked to its public source." %}{% set ogPath = "" %}{% include "social.njk" %}
{% set root = "" %}{% include "shared-head.njk" %}
<script src="app.js"></script>
</head>
<body class="homepage">
<div class="wrap" id="top">
{% set current = "home" %}{% include "project-bar.njk" %}

<header>
  <p class="eyebrow">Pasco County, Florida &#183; a guide for residents</p>
  <h1>Pasco Roadmap</h1>
  {#- Patrick's own words (29 Sep 2026) - ask before rewording. His personal
      view on Rangeland stays on the Rangeland page, where it applies. -#}
  <p class="standfirst">Hi, I&#8217;m Patrick, a resident in Bexley. I put this site together from public documents to help my neighbors in Pasco follow various road projects planned or in progress around us. I&#8217;m not affiliated with Pasco County, the MPO, or any other organizations. My goal is to make clear what is planned, and make numbers, dates, and facts easy to find and validate.</p>
</header>

<section class="hwhat" aria-label="What this site is">
  <div class="hpoint"><h2>Plain language</h2><p>Each project gets the same sections, asked the same questions, whether a lot or a little has been published about it.</p></div>
  <div class="hpoint"><h2>Every figure sourced</h2><p>Tap any underlined figure, or a statement marked &#8224;, to see the document it comes from and how it has been checked.</p></div>
  <div class="hpoint"><h2>Open to scrutiny</h2><p>If you&#8217;ve compared a figure with its document, tell me whether it matches. Corrections are published, not quietly made.</p></div>
</section>

<section id="coming-up" aria-labelledby="h-coming">
  <h2 id="h-coming" class="hh">Coming up</h2>
  {%- set ups = timeline.upcoming | reverse %}
  {% if ups.length %}
  <ol class="hup">
    {% for e in ups %}<li><span class="dt">{{ e.shown }}</span><span class="hup-body"><span class="hup-tags">{% for n in e.projectTags %}<span class="pjtag pj-{{ n.id }}">{{ n.name }}</span>{% endfor %}</span><a href="timeline/#{{ e.id }}">{{ e.title }}</a></span></li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="notyet">No meetings or deadlines have been announced for any project.</p>
  {% endif %}
  <p class="hmore"><a href="timeline/">The full timeline, including what&#8217;s planned &#8594;</a></p>
</section>

<section id="projects" aria-labelledby="h-projects">
  <h2 id="h-projects" class="hh">Projects covered here</h2>
  <p class="hlead">Each of these has its own guide: every figure is sourced and checked against its document, and I keep it up to date.</p>
  <div class="hcards">
  {% for p in projects %}{% if p.page %}
    {%- set lately = recentEvents[p.id] %}{% set ck = projectChecks[p.id] %}
    <a class="hcard" href="{{ p.id }}/">
      <span class="hc-name"><span class="pjtag pj-{{ p.id }}">{{ p.short }}</span></span>
      <span class="hc-title">{{ p.name }}</span>
      <span class="hc-stage">{{ p.stage }}</span>
      <span class="hc-about">{{ p.about }}</span>
      <span class="hc-rows">
        <span class="hc-row"><span class="hc-k">Next</span>{% if lately.upcoming.length %}{{ lately.upcoming[0].shown }} &#8212; {{ lately.upcoming[0].title }}{% else %}No dates announced{% endif %}</span>
        {% if lately.past.length %}<span class="hc-row"><span class="hc-k">Latest</span>{{ lately.past[0].shown }} &#8212; {{ lately.past[0].title }}</span>{% endif %}
        {% if ck %}<span class="hc-row"><span class="hc-k">Figures</span>{{ ck.total }} sourced &#183; {{ ck.human }} verified by a human ({{ ck.pct }}%)</span>{% endif %}
      </span>
      <span class="hc-go">Open the {{ p.short }} &#8594;</span>
    </a>
  {% endif %}{% endfor %}
  </div>
</section>

<section id="other-projects" aria-labelledby="h-other">
  <h2 id="h-other" class="hh">Other projects in Pasco</h2>
  <p class="hlead">These are <strong>listed only</strong>, not covered: {{ projectList.otherCount }} more projects, one line each, copied as written from {% for s in projectList.sources %}{{ s.title }}{% if s.dateText %} ({{ s.dateText }}){% endif %}{% if not loop.last %} and {% endif %}{% endfor %}, with links to the official pages. They aren&#8217;t checked or kept up to date here, so follow the links for the latest. <a href="explore/">Explore by Road</a> shows them road by road.</p>
  {%- set F = projectList.filters %}
  <div class="plfilters" id="plfilters" hidden>
    <label class="xp-sel"><span>Agency</span><select data-f="agency"><option value="">Any</option>{% for o in F.agencies %}<option value="{{ o.v }}">{{ o.v }} ({{ o.n }})</option>{% endfor %}</select></label>
    <label class="xp-sel"><span>List</span><select data-f="list"><option value="">Any</option>{% for g in projectList.groups %}{% if g.rows.length %}<option value="{{ g.k }}">{{ g.label }} ({{ g.rows.length }})</option>{% endif %}{% endfor %}</select></label>
    <label class="xp-sel"><span>FDOT phase</span><select data-f="phase"><option value="">Any</option>{% for o in F.phases %}<option value="{{ o.v }}">{{ o.v }} ({{ o.n }})</option>{% endfor %}<option value="-">Not on FDOT&#8217;s list</option></select></label>
    <label class="xp-sel"><span>Road</span><select data-f="road"><option value="">Any</option>{% for o in F.roads %}<option value="{{ o.v }}">{{ o.name }} ({{ o.n }})</option>{% endfor %}<option value="-">No road named</option></select></label>
  </div>
  <p class="plshowing" id="plshowing" role="status" aria-live="polite" hidden></p>
  {% for g in projectList.groups %}{% if g.rows.length %}
  <details class="plgroup" data-group="{{ g.k }}">
    <summary>{{ g.label }} <span class="plcount" data-total="{{ g.rows.length }}">{{ g.rows.length }}</span></summary>
    <ul class="plist">{% for r in g.rows %}{% include "listed-row.njk" %}{% endfor %}</ul>
  </details>
  {% endif %}{% endfor %}
</section>

<section id="checks" aria-labelledby="h-checks">
  <h2 id="h-checks" class="hh">How the figures are checked</h2>
  <div class="fkey">
    {% include "checkbar.njk" %}
  </div>
  <p>Every figure is compared with its document, first by Claude, an AI assistant, and then by me. You can help: <a href="facts/#help-check">see the figures not yet verified by a person</a>, open one, and say whether it matches its document. Every figure and document is listed on <a href="facts/">All figures &amp; sources</a>.</p>
</section>

<section id="involved" aria-labelledby="h-involved">
  <h2 id="h-involved" class="hh">How to get involved</h2>
  <ul>
    {% for p in projects %}{% for e in recentEvents[p.id].upcoming %}{% if e.type == "deadline" %}
    <li><strong>{{ p.short }}, {{ e.shown }}:</strong> {{ e.title }}. <a href="{{ p.id }}/#s9">How to send a comment &#8594;</a></li>
    {% endif %}{% endfor %}{% endfor %}
    <li><strong>Any project:</strong> the Pasco County Commission takes public comment at its regular meetings. Its agendas, where contracts and change orders appear, are searchable at <strong>pascocofl.portal.civicclerk.com</strong>.</li>
    <li><strong>A project you&#8217;d like covered?</strong> <a href="about/#contact">Send me a message</a>. I add projects as time allows, and only once I&#8217;ve verified at least {{ publishThreshold }}% of the figures in every project already here, so the site never runs ahead of its checking.{% if not nextProjectReady %} Where things stand: {% for p in projects %}{% if p.page %}{{ p.short }} {{ projectChecks[p.id].pct }}%{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}.{% endif %} Each gets the same sections and the same checks as the others.</li>
  </ul>
</section>

<footer>
  <p style="margin:0 0 10px"><strong>Corrections policy.</strong> If a fact here doesn&#8217;t match its source document, tap the figure and say so in the box, and I will do my best to fix it within 72 hours. Corrections are listed on each project&#8217;s page.</p>
  <p style="margin:0 0 10px"><strong>How this is made.</strong> I use AI tools for the code behind this site, to help dig through the documents, and for first drafts of the writing. I read and check everything before it goes up, and every figure is sourced so you can check it without taking my word for it.</p>
  <p style="margin:0 0 10px"><strong>Visit counter.</strong> This site counts visits using GoatCounter. It sets no cookies, stores nothing on your device and does not identify you.</p>
  {% include "share.njk" %}
  <p class="buildstamp">Version {% if build.url %}<a href="{{ build.url }}">{{ build.version }}</a>{% else %}{{ build.version }}{% endif %}{% if build.pr %} &#183; <a href="{{ build.prUrl }}">pull request #{{ build.pr }}</a>{% endif %} &#183; published {{ build.when }} &#183; <a href="{{ root }}about/">How this site is built</a></p>
</footer>
</div>
<script>
/* Other projects in Pasco: four filters - agency, list, FDOT phase, road - over
   the listed rows (data- attributes from listed-row.njk). Choosing any opens the
   groups that still have rows and shows "x of y" on each; groups with none are
   hidden. Without JavaScript the filters stay hidden and every row shows. */
(function(){
  var box = document.getElementById("plfilters"); if (!box) return;
  var sels = box.querySelectorAll("select"), groups = document.querySelectorAll("#other-projects .plgroup");
  var showing = document.getElementById("plshowing");
  box.hidden = false;
  function match(li, f, v){
    if (!v) return true;
    if (f === "agency") return li.getAttribute("data-agencies").indexOf("|" + v + "|") >= 0;
    if (f === "list") return li.getAttribute("data-list") === v;
    if (f === "phase") return v === "-" ? !li.getAttribute("data-phase") : li.getAttribute("data-phase") === v;
    if (f === "road") return v === "-" ? !li.getAttribute("data-roads").trim() : li.getAttribute("data-roads").indexOf(" " + v + " ") >= 0;
    return true;
  }
  function apply(){
    var active = false, total = 0, i, j;
    for (i = 0; i < sels.length; i++) if (sels[i].value) active = true;
    for (i = 0; i < groups.length; i++){
      var rows = groups[i].querySelectorAll(".lrow"), n = 0, cnt = groups[i].querySelector(".plcount");
      for (j = 0; j < rows.length; j++){
        var ok = true;
        for (var k = 0; k < sels.length; k++) if (!match(rows[j], sels[k].getAttribute("data-f"), sels[k].value)) ok = false;
        rows[j].hidden = !ok; if (ok) n++;
      }
      total += n;
      groups[i].hidden = active && !n;
      cnt.textContent = active ? n + " of " + cnt.getAttribute("data-total") : cnt.getAttribute("data-total");
      if (active) groups[i].open = n > 0;
    }
    showing.hidden = !active;
    showing.textContent = active ? (total ? total + (total === 1 ? " listed project matches." : " listed projects match.") : "No listed projects match these choices.") : "";
  }
  for (var i = 0; i < sels.length; i++) sels[i].addEventListener("change", apply);
})();
</script>
<script data-goatcounter="https://patricka3s.goatcounter.com/count"
        async src="https://gc.zgo.at/count.js"></script>
</body>
</html>
